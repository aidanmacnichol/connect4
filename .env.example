# Server
ADDR=:8080

# Postgres (matches docker-compose defaults)
POSTGRES_USER=connect4
POSTGRES_PASSWORD=connect4
POSTGRES_DB=connect4
DATABASE_URL=postgres://connect4:connect4@localhost:5432/connect4?sslmode=disable

# Google OAuth (fill in from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Web (Vite) — copy into web/.env if you want overrides
# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080/api/ws
