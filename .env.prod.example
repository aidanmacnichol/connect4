# Copy to .env when running docker-compose.prod.yml

POSTGRES_USER=connect4
POSTGRES_PASSWORD=change-me
POSTGRES_DB=connect4

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Same public origin for app + API (Caddy)
FRONTEND_URL=https://connect4.example.com
OAUTH_REDIRECT_URL=https://connect4.example.com/api/auth/google/callback
CORS_ORIGINS=https://connect4.example.com
COOKIE_SECURE=true

# Caddy site address: domain for Let's Encrypt, or ":80" for local HTTP smoke test
SITE_ADDRESS=connect4.example.com
